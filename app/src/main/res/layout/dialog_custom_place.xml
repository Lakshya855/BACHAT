<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CUSTOM SPACE"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:letterSpacing="0.14"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name Your Space"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Give your new environment a memorable name"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="18dp" />

    <EditText
        android:id="@+id/etCustomPlaceName"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_input_dark"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:hint="e.g. Basement Studio, Warehouse B"
        android:inputType="textCapWords"
        android:textSize="15sp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelCustomPlace"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            app:cornerRadius="26dp"
            app:strokeColor="@color/stroke_color"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCustomPlace"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Create Space"
            android:textColor="@color/bg_main"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_green"
            app:cornerRadius="26dp" />
    </LinearLayout>

</LinearLayout>
