<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_color"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Priority Badge & BEE Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvSchedulePriorityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH PRIORITY"
                android:textColor="@color/accent_green"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tvScheduleBeeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEE 5-Star · BLDC"
                android:textColor="@color/accent_purple_light"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Main Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Category Icon -->
            <FrameLayout
                android:id="@+id/flScheduleIconBg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/ivScheduleIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_rotate"
                    app:tint="@color/accent_green" />
            </FrameLayout>

            <!-- Name and Specs -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvScheduleAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appliance Name"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScheduleAppSpecs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 Unit · 75 Watts"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Recommended Operating Hours Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvScheduleHoursBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5 hrs / day"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp" />

                <TextView
                    android:id="@+id/tvScheduleMaxHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current: 8.0 hrs"
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke_color"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <!-- Status & Impact Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvScheduleStatusNote"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Trim runtime by 3.5h to hit savings target"
                android:textColor="@color/accent_teal"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScheduleSavingsSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saves ₹ 28.00 / day"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
