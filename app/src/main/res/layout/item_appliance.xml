<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_color"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon Container and Inline Stepper Capsule (Image 5) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/flAppIconBg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/ivAppIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="@color/accent_purple"
                    android:contentDescription="Appliance Icon" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp" />

            <!-- Stepper Capsule [ -  1  + ] -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:id="@+id/btnQtyMinus"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_remove"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Decrease Quantity"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvAppQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="1"
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnQtyPlus"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_add"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Increase Quantity"
                    app:tint="@color/accent_green" />
            </LinearLayout>
        </LinearLayout>

        <!-- Appliance Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appliance"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Power & Hours Specs -->
        <TextView
            android:id="@+id/tvAppWattage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100W · 8h/day"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="3dp" />

        <!-- Monthly Cost Badge -->
        <TextView
            android:id="@+id/tvAppMonthlyCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 288 / mo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent_green"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
