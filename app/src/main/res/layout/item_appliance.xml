<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_color"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Main Row: Icon, Info, Stepper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Appliance Icon Circle -->
            <FrameLayout
                android:id="@+id/flAppIconBg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/ivAppIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="@color/accent_purple"
                    android:contentDescription="Appliance Icon" />
            </FrameLayout>

            <!-- Center Info: Appliance Name & Specs -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appliance Name"
                    android:textStyle="bold"
                    android:textSize="15.5sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvAppWattage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100W · Requested: 8.0h/day"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Inline Stepper Capsule [- Qty +] -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:id="@+id/btnQtyMinus"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_remove"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Decrease Quantity"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvAppQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="7dp"
                    android:text="1"
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnQtyPlus"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_add"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Increase Quantity"
                    app:tint="@color/accent_green" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke_color"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Bottom Row: Operating Hours Badge & Cost Telemetry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAppAllocatedHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Should Run: 4.5 hrs / day"
                android:textColor="@color/accent_green"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvAppMonthlyCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 288 / mo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent_green" />

            <!-- Hidden badge for backward compatibility -->
            <TextView
                android:id="@+id/tvAppBenefitBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
