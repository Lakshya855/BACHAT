<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".Signup">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_bg"
        app:strokeColor="@color/stroke_color"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Profile Photo Avatar with Edit Badge -->
            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imageViewProfilePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_icon_circle"
                    android:scaleType="centerCrop"
                    android:contentDescription="Profile Photo"
                    app:srcCompat="@drawable/img" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="@drawable/bg_icon_circle_green"
                    android:padding="5dp"
                    android:contentDescription="Select Photo"
                    app:tint="@color/bg_main" />
            </FrameLayout>

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent_green"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textSize="26sp"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create your energy account"
                android:textColor="@color/text_secondary"
                android:textAlignment="center"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Input Fields -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editTextName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_dark"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:paddingHorizontal="14dp"
                android:hint="e.g. Rahul Sharma"
                android:inputType="textPersonName"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editTextEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_dark"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:paddingHorizontal="14dp"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSWORD"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editTextPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_dark"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:paddingHorizontal="14dp"
                android:hint="Create a secure password"
                android:inputType="textPassword"
                android:textSize="15sp" />

            <!-- Gender -->
            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:text="GENDER"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/Radiogroupgender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButtonMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_green"
                    android:layout_weight="1"
                    android:text="Male"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioButtonFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_green"
                    android:layout_weight="1"
                    android:text="Female"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioButtonOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_green"
                    android:text="Other"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- State -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:text="INDIAN STATE (FOR TARIFF RATES)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerState"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_dark"
                android:paddingHorizontal="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:text="ELECTRICITY PROVIDER (DISCOM)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerDiscom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_dark"
                android:paddingHorizontal="12dp" />

            <!-- Policy Checkbox -->
            <CheckBox
                android:id="@+id/checkBoxNewsletter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:buttonTint="@color/accent_green"
                android:text="I agree to the terms and privacy policy" />

            <!-- Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="22dp"
                android:text="Create Bachat Account"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/on_accent_green"
                android:background="@drawable/bg_button_gradient_green"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_bolt"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/bg_main"
                app:cornerRadius="31dp"
                android:elevation="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/googleSignIn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="Sign up with Google"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconTint="@null"
                app:strokeColor="@color/stroke_color"
                app:strokeWidth="1.5dp" />

            <Button
                android:id="@+id/contact_support"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:textColor="@color/accent_purple_light"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:text="Need help? Contact Support" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
