<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUPPORT TICKET"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:letterSpacing="0.14"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Report a Problem"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tell us what went wrong so we can resolve it quickly"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ISSUE TITLE"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etReportTitle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_dark"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:hint="Brief summary of the issue"
        android:inputType="textCapSentences"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DESCRIPTION"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etReportDesc"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/bg_input_dark"
        android:padding="14dp"
        android:gravity="top"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:hint="Explain what happened..."
        android:inputType="textMultiLine"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReport"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            app:cornerRadius="26dp"
            app:strokeColor="@color/stroke_color"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReport"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Submit Ticket"
            android:textColor="@color/on_accent_green"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_green"
            app:cornerRadius="26dp" />
    </LinearLayout>

</LinearLayout>
