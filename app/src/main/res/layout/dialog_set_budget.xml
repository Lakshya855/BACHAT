<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Badge & Title -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_icon_circle_green"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvBudgetBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ELECTRICITY BUDGET"
            android:textColor="@color/accent_green"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBudgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target Electricity Spend"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBudgetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="How much do you want to spend on electricity daily or monthly?"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- Period Selector (Daily vs Monthly Spend) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_input_dark"
        android:padding="3dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tabDailyMode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Daily Spend (₹/day)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabMonthlyMode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Monthly Spend (₹/mo)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/on_accent_green"
            android:background="@drawable/bg_chip_selected"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Spend Amount Input Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/stroke_color"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#141620">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET ELECTRICITY SPEND"
                android:textColor="@color/accent_green"
                android:textSize="10.5sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCurrencySymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ "
                    android:textColor="@color/accent_green"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBudgetAmount"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:background="@null"
                    android:hint="1500"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBudgetPeriodUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ month"
                    android:textColor="@color/accent_teal"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Dynamic Equivalence Hint -->
            <TextView
                android:id="@+id/tvEquivalentHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="≈ ₹ 50 / day savings goal"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Preset Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/chipOption1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="₹ 500"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chipOption2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="₹ 1,000"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chipOption3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="₹ 2,000"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelBudget"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            app:cornerRadius="26dp"
            app:strokeColor="@color/stroke_color"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetBudget"
            android:layout_width="0dp"
            android:layout_weight="1.6"
            android:layout_height="52dp"
            android:text="Calculate Smart Hours"
            android:textColor="@color/on_accent_green"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_green"
            app:cornerRadius="26dp" />
    </LinearLayout>

</LinearLayout>
